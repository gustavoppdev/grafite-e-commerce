// Prisma 7: as URLs de conexão não ficam mais aqui, e sim em prisma.config.ts (CLI)
// e em src/server/db.ts (aplicação, via adaptador).

generator client {
  provider = "prisma-client"
  // Gerado dentro de src/ para ser importado como `@/generated/prisma/client`.
  // É código gerado: fica fora do git e é recriado por `pnpm db:generate` / postinstall.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (better-auth) ──────────────────────────────────────────────────────────
//
// Gerado pela CLI do better-auth (`auth generate`) e revisado à mão; como gerar de novo
// está no ticket 04 de `auth-core`. Se mudar plugin ou opção que mexe em tabela no
// `src/server/auth.ts`, gere de novo: na inicialização o better-auth compara este schema
// com o que ele espera e responde 500 em toda rota de auth se divergir.
//
// Depois de toda migration: `pnpm db:generate`. No Prisma 7 o `migrate dev` NÃO gera mais
// o client, e o better-auth confere o client gerado, não o banco: tabela criada e client
// velho também dá 500 (`SCHEMA_MISMATCH`, visto no ticket 13).
//
// Três escolhas que valem notar:
// - `id String @id` SEM `@default`: o better-auth gera um ID aleatório na aplicação.
//   Nunca `autoincrement()`: ID sequencial deixa adivinhar o registro seguinte (IDOR) e
//   revela quantas contas a loja tem.
// - `role` pode ser nulo: quem grava "user" é o plugin admin, no cadastro. Um usuário
//   criado por fora dele fica com `null`, e `requireAdmin` compara com "admin", então
//   nulo cai no lado seguro (sem acesso).
// - `onDelete: Cascade`: apagar um usuário apaga as sessões e contas dele. Sem isso, a
//   sessão sobreviveria ao dono.

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  // Hash scrypt da senha (nunca a senha). Mora em `account`, não em `user`, então uma
  // query de usuário não carrega o hash por acidente.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Rate limit (better-auth) ────────────────────────────────────────────────────
//
// Contador de tentativas das rotas `/api/auth/*`. Só existe porque o `src/server/auth.ts`
// usa `rateLimit.storage: "database"`; também gerado pela CLI (ticket 13 de `auth-core`).
//
// - `key` é `${ip}|${caminho}`, ex. "203.0.113.7|/sign-in/email". Único: é por ele que o
//   better-auth acha a linha, e a unicidade é o que impede duas requisições simultâneas
//   de criarem dois contadores para a mesma chave (a segunda falha e relê a primeira).
// - `lastRequest` é o instante da última tentativa ACEITA, em milissegundos (Date.now()).
//   Não cabe num Int de 32 bits, por isso BigInt.
// - Guarda IP, que é dado pessoal. As linhas se apagam sozinhas: o better-auth remove as
//   mais velhas que a maior janela configurada sempre que um contador recomeça.
model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}
